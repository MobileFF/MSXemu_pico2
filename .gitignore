# Copyrighted ROM/BIOS dumps and third-party reference material with
# uncertain redistribution rights (e.g. Casio PB-1000 command reference
# derived docs) — kept locally only, never published.
/roms/
/references/

# Local investigation/scratch folder — mixes working notes with
# copyrighted ROM dumps and reference PDFs; always excluded (user
# instruction, 2026-09-29).
/調査用/

# Build artifacts (test .uf2 outputs from bare-metal diagnostic harnesses,
# not part of the shipped firmware).
/firmware/test/

# Local dev-tool/session state — not part of the project itself.
.claude/
**/.claude/

# Personal debugging trace logs accumulated during development.
/log/

# Build artifacts (regenerate via bldfrm_msx.sh / hdmi_bridge's build.sh).
__pycache__/
build/
build-*/
*.pyc
